<header>
  <p class="period-type"><%= @period.type.to_s.capitalize %></p>
  <h1><%= @period.label %></h1>
  <% if @period.subtitle %><p class="subtitle"><%= @period.subtitle %></p><% end %>
  <nav class="period-nav">
    <% if @prev_period %>
      <a href="<%= @prev_period.to_param %>.html" rel="prev">← Previous</a>
    <% else %>
      <span class="disabled">← Previous</span>
    <% end %>
    <% if @next_period %>
      <a href="<%= @next_period.to_param %>.html" rel="next">Next →</a>
    <% else %>
      <span class="disabled">Next →</span>
    <% end %>
  </nav>
</header>

<% if @ranking.empty? %>
  <p class="empty">No merged PRs in this period.</p>
<% else %>
  <table class="ranking">
    <thead><tr><th>Rank</th><th>Contributor</th><th>PRs</th></tr></thead>
    <tbody>
      <% @ranking.rows.each do |row| %>
        <tr>
          <td class="rank"><%= row.rank %></td>
          <td class="contributor">
            <% if row.user["avatar_url"] %><img src="<%= row.user["avatar_url"] %>" alt="" width="24" height="24"><% end %>
            <span><%= row.user["name"] || row.user["login"] %></span>
            <% unless row.user["active"] %><span class="inactive" title="No longer in any tracked team">(inactive)</span><% end %>
          </td>
          <td class="count"><%= row.count %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <p class="totals"><%= @ranking.contributor_count %> contributors · <%= @ranking.total_count %> merged PRs</p>
<% end %>
