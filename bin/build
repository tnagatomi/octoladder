#!/usr/bin/env ruby

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "octoladder/config"
require "octoladder/state"
require "octoladder/site"

OctoladderConfig.load.apply!

state_path = File.expand_path("../data/state.json", __dir__)
output_dir = File.expand_path("../site", __dir__)

state = State.load(state_path)
Site.new(state: state, output_dir: output_dir).call
